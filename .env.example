# ──────────────────────────────────────
# DevPilot Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env files to version control
# ──────────────────────────────────────

# ── Backend ───────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── GitHub OAuth ─────────────────────
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── Session ───────────────────────────
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production

# ── Database ──────────────────────────
DATABASE_URL=

# ── Neo4j ─────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Groq AI (LLM) ────────────────────
# Get your API key at: https://console.groq.com/keys
# Groq is OpenAI-compatible — uses llama-3.3-70b-versatile by default
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Embeddings (separate provider) ────
# Groq does NOT support embeddings. Configure a separate provider:
# - OpenAI: EMBEDDING_BASE_URL=https://api.openai.com/v1, EMBEDDING_API_KEY=<your-key>
# - Cohere: EMBEDDING_BASE_URL=https://api.cohere.com/v2, EMBEDDING_API_KEY=<your-key>
# - Leave blank to disable embeddings (semantic search will be unavailable)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
